{
  "name": "@softstroke/svelte",
  "version": "1.0.0",
  "description": "Softstroke icons as Svelte 5 components",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.svelte.d.ts",
      "svelte": "./dist/icons/*.svelte",
      "default": "./dist/icons/*.svelte"
    },
    "./solid": {
      "types": "./dist/solid/index.d.ts",
      "svelte": "./dist/solid/index.js",
      "default": "./dist/solid/index.js"
    },
    "./solid/icons/*": {
      "types": "./dist/solid/icons/*.svelte.d.ts",
      "svelte": "./dist/solid/icons/*.svelte",
      "default": "./dist/solid/icons/*.svelte"
    }
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "icons",
    "svg",
    "softstroke"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sarthak102/softstroke.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://sarthak102.github.io/softstroke/",
  "bugs": {
    "url": "https://github.com/Sarthak102/softstroke/issues"
  }
}
